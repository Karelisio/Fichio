<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fichio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Fichio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Fichio</item>
    </style>
</resources>
