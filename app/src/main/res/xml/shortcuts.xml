<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="storage" android:enabled="true"
        android:icon="@drawable/ic_shortcut_storage" android:shortcutShortLabel="@string/shortcut_storage">
        <intent android:action="android.intent.action.MAIN"
            android:targetPackage="com.karelisio.fichio" android:targetClass="com.karelisio.fichio.MainActivity">
            <extra android:name="com.karelisio.fichio.extra.DESTINATION" android:value="browser" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="downloads" android:enabled="true"
        android:icon="@drawable/ic_shortcut_downloads" android:shortcutShortLabel="@string/shortcut_downloads">
        <intent android:action="android.intent.action.MAIN"
            android:targetPackage="com.karelisio.fichio" android:targetClass="com.karelisio.fichio.MainActivity">
            <extra android:name="com.karelisio.fichio.extra.PATH" android:value="/storage/emulated/0/Download" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="search" android:enabled="true"
        android:icon="@drawable/ic_shortcut_search" android:shortcutShortLabel="@string/shortcut_search">
        <intent android:action="android.intent.action.MAIN"
            android:targetPackage="com.karelisio.fichio" android:targetClass="com.karelisio.fichio.MainActivity">
            <extra android:name="com.karelisio.fichio.extra.DESTINATION" android:value="search" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="trash" android:enabled="true"
        android:icon="@drawable/ic_shortcut_trash" android:shortcutShortLabel="@string/shortcut_trash">
        <intent android:action="android.intent.action.MAIN"
            android:targetPackage="com.karelisio.fichio" android:targetClass="com.karelisio.fichio.MainActivity">
            <extra android:name="com.karelisio.fichio.extra.DESTINATION" android:value="trash" />
        </intent>
    </shortcut>
</shortcuts>
